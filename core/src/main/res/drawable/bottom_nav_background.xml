<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle indigo-tinted glassy surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surfaceColor" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <!-- Premium indigo accent layer — 8% opacity overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#143D5AFE" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <!-- Fine border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#303D5AFE" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>
