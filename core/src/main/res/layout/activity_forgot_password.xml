<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundColor"
    tools:context=".ui.login.activity.ForgotPasswordActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Ambient Glow Spot Top-Left -->
        <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="-120dp"
            android:layout_marginTop="-120dp"
            android:background="@drawable/glow_blue" />

        <!-- Ambient Glow Spot Bottom-Right -->
        <View
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="-120dp"
            android:layout_marginBottom="-120dp"
            android:background="@drawable/glow_purple" />

        <!-- Content Container with 20% top spacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/screen_margin_horizontal"
            android:orientation="vertical"
            android:weightSum="1.0">

            <!-- 20% Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.2" />

            <!-- Form Card (Frosted/White Surface) -->
            <LinearLayout
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_forgot_password"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/text_size_extra_large"
                android:textColor="@color/onBackgroundColor"
                android:layout_marginBottom="@dimen/spacing_medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desc_forgot_password"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginBottom="@dimen/auth_title_margin_bottom"
                android:lineSpacingMultiplier="1.1" />

            <!-- Email Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                style="@style/AuthTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email_address"
                android:layout_marginBottom="@dimen/auth_input_margin_bottom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/onSurfaceColor"
                    android:fontFamily="@font/poppins"
                    android:textSize="@dimen/text_size_medium" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Send Reset Link Button -->
            <Button
                android:id="@+id/buttonSendReset"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:text="@string/btn_send_reset_link"
                android:textColor="@color/fixed_white"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_size_normal"
                android:background="@drawable/button_background"
                app:backgroundTint="@null"
                android:elevation="@dimen/spacing_tiny"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/auth_title_margin_bottom" />

            <!-- Back to Login Footer Link -->
            <TextView
                android:id="@+id/textViewBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/label_back_to_login"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/BLUE"
                android:textSize="@dimen/text_size_medium"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="@dimen/auth_footer_margin_vertical"
                android:layout_marginBottom="@dimen/auth_footer_margin_vertical"
                android:background="?android:attr/selectableItemBackground" />

        </LinearLayout>

    </LinearLayout>

    </RelativeLayout>
</ScrollView>
