<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ReportFragment">

    <LinearLayout
        android:id="@+id/languageSwitchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/spacing_medium"
        android:layout_gravity="end"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium">

        <ImageView
            android:layout_width="@dimen/audio_icon_size"
            android:layout_height="@dimen/audio_icon_size"
            android:scaleType="fitCenter"
            android:src="@drawable/language"/> <!-- Add a language icon -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:textColor="@color/Grey"
            android:text="@string/label_language"
            android:layout_marginEnd="7dp"
            android:layout_marginStart="@dimen/spacing_small"
            android:textSize="@dimen/text_size_medium"/>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/details_content_margin_top"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:layout_marginBottom="@dimen/details_content_margin_bottom"
        android:orientation="vertical">

        <!-- Scrollable Content -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/responseTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/Grey"
                android:padding="@dimen/spacing_normal"
                android:justificationMode="inter_word" />

        </ScrollView>

    </LinearLayout>

    <!-- Bottom Container with Actions -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="@dimen/details_bottom_container_width"
        android:layout_height="@dimen/details_bottom_container_height"
        android:layout_gravity="center_horizontal|bottom"
        android:padding="1dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/search_margin_horizontal"
        android:layout_marginStart="@dimen/screen_margin_horizontal"
        android:layout_marginEnd="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/app_logo_margin_top"
        android:background="@drawable/rounded_container_file">

        <!-- Edit Button -->
        <LinearLayout
            android:id="@+id/editlayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/details_action_icon_size"
                android:layout_height="@dimen/details_action_icon_size"
                android:src="@drawable/edit_document"
                android:scaleType="fitCenter"
                android:contentDescription="@string/content_desc_edit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_edit"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Export Button -->
        <LinearLayout
            android:id="@+id/exportlayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/details_action_icon_size"
                android:layout_height="@dimen/details_action_icon_size"
                android:src="@drawable/file_export"
                android:scaleType="fitCenter"
                android:contentDescription="@string/content_desc_export" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_export"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Share Button -->
        <LinearLayout
            android:id="@+id/sharelayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/details_action_icon_size"
                android:layout_height="@dimen/details_action_icon_size"
                android:src="@drawable/ios_share"
                android:scaleType="fitCenter"
                android:contentDescription="@string/content_desc_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_share"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Update Button (shown in edit mode) -->
        <LinearLayout
            android:id="@+id/updatelayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/details_action_icon_size"
                android:layout_height="@dimen/details_action_icon_size"
                android:src="@drawable/update"
                android:scaleType="fitCenter"
                android:contentDescription="Update"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_update"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Cancel Button (shown in edit mode) -->
        <LinearLayout
            android:id="@+id/cancellayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/details_action_icon_size"
                android:layout_height="@dimen/details_action_icon_size"
                android:src="@drawable/cancel"
                android:scaleType="fitCenter"
                android:contentDescription="Cancel"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_cancel"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Overlay for ProgressBar — unified card loader style (rendered on top) -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modal_blur"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_extra_large"
            android:background="@drawable/dialog_background_rounded"
            android:minWidth="@dimen/progress_overlay_min_width">

            <ProgressBar
                android:id="@+id/translationProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/progress_bar_size"
                android:layout_height="@dimen/progress_bar_size"
                android:indeterminateTint="@color/BLUE"
                android:indeterminateTintMode="src_in" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:text="@string/placeholder_loading"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_size_instruction"
                android:textColor="@color/onSurfaceColor" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>