<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_export_options.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exportDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background_rounded"
    android:padding="@dimen/profile_card_margin_horizontal">

    <!-- Title and Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_title_choose_format"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="@dimen/text_size_large"
        android:textColor="@color/onSurfaceColor"
        android:gravity="start"
        android:layout_marginBottom="@dimen/spacing_small" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_subtitle_export_format"
        android:fontFamily="@font/poppins"
        android:textSize="@dimen/text_size_instruction"
        android:textColor="@color/onSurfaceVariant"
        android:gravity="start"
        android:layout_marginBottom="@dimen/profile_card_margin_horizontal" />

    <!-- PDF Option Card -->
    <LinearLayout
        android:id="@+id/pdfButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large"
        android:gravity="center_vertical"
        android:background="@drawable/list_item_background"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="@dimen/spacing_normal">

        <FrameLayout
            android:layout_width="@dimen/dialog_option_icon_container_size"
            android:layout_height="@dimen/dialog_option_icon_container_size"
            android:background="@drawable/rounded_image"
            android:backgroundTint="@color/export_pdf_bg_tint"
            android:layout_marginEnd="@dimen/spacing_large">

            <ImageView
                android:id="@+id/pdfImage"
                android:layout_width="@dimen/profile_row_icon_size"
                android:layout_height="@dimen/profile_row_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/pdf"
                android:contentDescription="@string/content_desc_pdf_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pdfText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_pdf_document"
                android:textSize="@dimen/text_size_normal"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/onSurfaceColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_pdf_desc"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins"
                android:textColor="@color/onSurfaceVariant" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/selected_file_icon_size"
            android:layout_height="@dimen/selected_file_icon_size"
            android:src="@drawable/next"
            android:contentDescription="@string/content_desc_next"
            app:tint="@color/onSurfaceVariant" />

    </LinearLayout>

    <!-- DOCX Option Card -->
    <LinearLayout
        android:id="@+id/docxButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_large"
        android:gravity="center_vertical"
        android:background="@drawable/list_item_background"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="@dimen/spacing_medium">

        <FrameLayout
            android:layout_width="@dimen/dialog_option_icon_container_size"
            android:layout_height="@dimen/dialog_option_icon_container_size"
            android:background="@drawable/rounded_image"
            android:backgroundTint="@color/export_docx_bg_tint"
            android:layout_marginEnd="@dimen/spacing_large">

            <ImageView
                android:id="@+id/docxImage"
                android:layout_width="@dimen/profile_row_icon_size"
                android:layout_height="@dimen/profile_row_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/doc_1"
                android:contentDescription="@string/content_desc_docx_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/docxText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_docx_document"
                android:textSize="@dimen/text_size_normal"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/onSurfaceColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_docx_desc"
                android:textSize="@dimen/text_size_small"
                android:fontFamily="@font/poppins"
                android:textColor="@color/onSurfaceVariant" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/selected_file_icon_size"
            android:layout_height="@dimen/selected_file_icon_size"
            android:src="@drawable/next"
            android:contentDescription="@string/content_desc_next"
            app:tint="@color/onSurfaceVariant" />

    </LinearLayout>

</LinearLayout>
