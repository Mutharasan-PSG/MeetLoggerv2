<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/toolbar_padding_horizontal"
        android:paddingVertical="@dimen/toolbar_padding_vertical"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="@dimen/toolbar_button_size"
            android:layout_height="@dimen/toolbar_button_size"
            android:src="@drawable/back_arrow"
            android:padding="@dimen/toolbar_button_padding"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/BLUE"
            android:contentDescription="@string/content_desc_back" />

        <TextView
            android:id="@+id/Profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:layout_marginStart="@dimen/toolbar_title_margin_start"
            android:fontFamily="@font/poppins_bold"
            android:textSize="@dimen/toolbar_title_text_size"
            android:textColor="@color/BLUE" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/version"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/profile_avatar_margin_top">

            <!-- Profile Image Container with Premium Border and Elevation -->
            <FrameLayout
                android:layout_width="@dimen/profile_avatar_container_size"
                android:layout_height="@dimen/profile_avatar_container_size"
                android:layout_marginTop="@dimen/profile_avatar_margin_top"
                android:elevation="@dimen/profile_avatar_elevation"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/profile_image"
                    android:layout_width="@dimen/profile_avatar_image_size"
                    android:layout_height="@dimen/profile_avatar_image_size"
                    android:layout_gravity="center"
                    android:src="@drawable/default_profile_pic"
                    android:contentDescription="@string/content_desc_profile_image"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image_background"
                    android:clipToOutline="true" />

                <!-- White premium stroke ring -->
                <View
                    android:layout_width="@dimen/profile_avatar_image_size"
                    android:layout_height="@dimen/profile_avatar_image_size"
                    android:layout_gravity="center"
                    android:background="@drawable/profile_pic_border" />
            </FrameLayout>

            <!-- Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/profile_card_margin_horizontal"
                android:layout_marginTop="@dimen/profile_card_margin_top"
                android:padding="@dimen/profile_card_padding"
                android:background="@drawable/profile_card_background"
                android:elevation="@dimen/profile_card_elevation">

                <!-- Name Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/profile_row_icon_size"
                        android:layout_height="@dimen/profile_row_icon_size"
                        android:src="@drawable/ic_profile"
                        android:layout_marginEnd="@dimen/profile_row_icon_margin_end"
                        app:tint="@color/BLUE"
                        android:contentDescription="@string/content_desc_name_icon" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_name_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_profile_name"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="@dimen/profile_row_placeholder_text_size"
                            android:letterSpacing="0.05"
                            android:textColor="@color/onSurfaceVariant" />

                        <TextView
                            android:id="@+id/profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_row_margin_top"
                            android:text="@string/placeholder_profile_actual_name"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/onSurfaceColor"
                            android:textSize="@dimen/profile_row_value_text_size" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_row_divider_height"
                    android:background="@color/dividerColor"
                    android:layout_marginVertical="@dimen/profile_row_divider_margin_vertical" />

                <!-- Email Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/profile_row_icon_size"
                        android:layout_height="@dimen/profile_row_icon_size"
                        android:src="@drawable/ic_mail"
                        android:layout_marginEnd="@dimen/profile_row_icon_margin_end"
                        app:tint="@color/BLUE"
                        android:contentDescription="@string/content_desc_email_icon" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profile_email_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_profile_email"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="@dimen/profile_row_placeholder_text_size"
                            android:letterSpacing="0.05"
                            android:textColor="@color/onSurfaceVariant" />

                        <TextView
                            android:id="@+id/profile_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/profile_row_margin_top"
                            android:textColor="@color/onSurfaceColor"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/placeholder_profile_default_email"
                            android:textSize="@dimen/profile_row_value_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Sign Out Button -->
            <LinearLayout
                android:id="@+id/btn_sign_out"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/profile_sign_out_btn_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/profile_sign_out_btn_margin_top"
                android:paddingHorizontal="@dimen/profile_sign_out_btn_padding_horizontal"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/sign_out_button_background"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sign_out_image"
                    android:layout_width="@dimen/profile_sign_out_icon_size"
                    android:layout_height="@dimen/profile_sign_out_icon_size"
                    android:src="@drawable/signout"
                    android:scaleType="fitCenter"
                    app:tint="@color/fixed_white"
                    android:contentDescription="@string/content_desc_sign_out" />

                <TextView
                    android:id="@+id/sign_out_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_sign_out"
                    android:textColor="@color/fixed_white"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="@dimen/profile_sign_out_text_size"
                    android:layout_marginStart="@dimen/profile_sign_out_text_margin_start" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Version Footer -->
    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/version_footer_margin_bottom"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/poppins"
        android:textColor="@color/onSurfaceVariant"
        android:text="@string/app_version"
        android:textSize="@dimen/version_footer_text_size" />

</RelativeLayout>