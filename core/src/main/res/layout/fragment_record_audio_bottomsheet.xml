<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surfaceColor">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surfaceColor"
            android:paddingBottom="@dimen/spacing_large">

            <!-- ── Drag Handle ── -->
            <View
                android:layout_width="@dimen/drag_handle_width"
                android:layout_height="@dimen/drag_handle_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/drag_handle_margin_top"
                android:layout_marginBottom="@dimen/drag_handle_margin_bottom"
                android:background="@color/dividerColor" />

            <!-- ── Header: Title + Subtitle ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_extra_large"
                android:paddingEnd="@dimen/mini_player_margin_horizontal"
                android:paddingTop="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_normal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_record_audio"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="@dimen/text_size_large"
                        android:textColor="@color/onSurfaceColor" />

                    <TextView
                        android:id="@+id/instructionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/msg_record_instruction"
                        android:fontFamily="@font/poppins"
                        android:textSize="@dimen/text_size_instruction"
                        android:textColor="@color/onSurfaceVariant"
                        android:maxLines="2" />

                </LinearLayout>

                <!-- Lock Toggle Icon -->
                <ImageView
                    android:id="@+id/lockToggle"
                    android:layout_width="@dimen/toolbar_button_size"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/BLUE"
                    android:padding="@dimen/toolbar_button_padding"
                    android:background="@drawable/lock_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:contentDescription="@string/content_desc_lock_toggle" />

            </LinearLayout>

            <!-- ── Divider ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/dividerColor"
                android:layout_marginBottom="@dimen/record_sheet_vertical_spacing" />

            <!-- ============================================================ -->
            <!--  Record Zone                                                 -->
            <!-- ============================================================ -->
            <FrameLayout
                android:layout_width="@dimen/record_ring_container_size"
                android:layout_height="@dimen/record_ring_container_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_medium">

                <View
                    android:id="@+id/recordPulseRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/record_button_ring"
                    android:visibility="invisible" />

                <View
                    android:layout_width="@dimen/record_ring_inner_halo_size"
                    android:layout_height="@dimen/record_ring_inner_halo_size"
                    android:layout_gravity="center"
                    android:background="@drawable/record_button_ring" />

                <FrameLayout
                    android:layout_width="@dimen/record_center_circle_size"
                    android:layout_height="@dimen/record_center_circle_size"
                    android:layout_gravity="center"
                    android:background="@drawable/record_button_bg"
                    android:elevation="@dimen/record_center_circle_elevation">

                    <ImageView
                        android:id="@+id/recordImageView"
                        android:layout_width="@dimen/record_center_icon_size"
                        android:layout_height="@dimen/record_center_icon_size"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/audioo"
                        app:tint="@color/fixed_white"
                        android:contentDescription="@string/content_desc_record_icon" />

                    <LinearLayout
                        android:id="@+id/equalizerContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/equalizer_container_height"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <View android:id="@+id/equalizerBar1" android:layout_width="@dimen/equalizer_bar_width" android:layout_height="@dimen/equalizer_bar1_height" android:layout_marginHorizontal="@dimen/equalizer_bar_margin" android:background="@drawable/equalizer_bar_bg" />
                        <View android:id="@+id/equalizerBar2" android:layout_width="@dimen/equalizer_bar_width" android:layout_height="@dimen/equalizer_bar2_height" android:layout_marginHorizontal="@dimen/equalizer_bar_margin" android:background="@drawable/equalizer_bar_bg" />
                        <View android:id="@+id/equalizerBar3" android:layout_width="@dimen/equalizer_bar_width" android:layout_height="@dimen/equalizer_bar3_height" android:layout_marginHorizontal="@dimen/equalizer_bar_margin" android:background="@drawable/equalizer_bar_bg" />
                        <View android:id="@+id/equalizerBar4" android:layout_width="@dimen/equalizer_bar_width" android:layout_height="@dimen/equalizer_bar4_height" android:layout_marginHorizontal="@dimen/equalizer_bar_margin" android:background="@drawable/equalizer_bar_bg" />
                        <View android:id="@+id/equalizerBar5" android:layout_width="@dimen/equalizer_bar_width" android:layout_height="@dimen/equalizer_bar5_height" android:layout_marginHorizontal="@dimen/equalizer_bar_margin" android:background="@drawable/equalizer_bar_bg" />
                    </LinearLayout>

                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/recording_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_large"
                android:text="@string/time_zero"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/timer_text_size"
                android:letterSpacing="0.05"
                android:textColor="@color/BLUE"
                android:visibility="gone" />

            <Space
                android:id="@+id/timerSpacer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/profile_card_margin_horizontal" />

            <LinearLayout
                android:id="@+id/recordingControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/record_sheet_vertical_spacing">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/action_button_height"
                    android:text="@string/btn_start"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/fixed_white"
                    android:textSize="@dimen/list_item_text_size"
                    android:paddingStart="@dimen/action_button_padding_horizontal"
                    android:paddingEnd="@dimen/action_button_padding_horizontal"
                    app:backgroundTint="@color/BLUE"
                    app:cornerRadius="@dimen/action_button_corner_radius"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/spacing_medium"
                    app:iconSize="@dimen/selected_file_icon_size"
                    app:iconTint="@color/fixed_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/action_button_height"
                    android:layout_marginStart="@dimen/spacing_normal"
                    android:text="@string/btn_stop"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/fixed_white"
                    android:textSize="@dimen/list_item_text_size"
                    android:paddingStart="@dimen/action_button_padding_horizontal"
                    android:paddingEnd="@dimen/action_button_padding_horizontal"
                    app:backgroundTint="@color/red"
                    app:cornerRadius="@dimen/action_button_corner_radius"
                    app:icon="@drawable/stop1"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/spacing_medium"
                    app:iconSize="@dimen/selected_file_icon_size"
                    app:iconTint="@color/fixed_white"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/savedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/miniPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bottom_sheet_card_background"
                    android:padding="@dimen/spacing_large"
                    android:layout_marginStart="@dimen/profile_card_margin_horizontal"
                    android:layout_marginEnd="@dimen/profile_card_margin_horizontal"
                    android:layout_marginBottom="@dimen/record_sheet_vertical_spacing">

                    <TextView
                        android:id="@+id/currentAudioName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/now_playing"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/onSurfaceColor"
                        android:maxLines="1"
                        android:ellipsize="marquee"
                        android:singleLine="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:layout_marginBottom="@dimen/option_item_padding" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_medium">

                        <TextView android:id="@+id/currentTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/time_zero" android:fontFamily="@font/poppins" android:textSize="@dimen/text_size_formats_desc" android:textColor="@color/onSurfaceVariant" />
                        <SeekBar android:id="@+id/seekBar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_medium" android:layout_marginEnd="@dimen/spacing_medium" android:progressDrawable="@drawable/seekbar_track" android:thumbTint="@color/BLUE" android:maxHeight="@dimen/drag_handle_height" android:minHeight="@dimen/drag_handle_height" />
                        <TextView android:id="@+id/totalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/time_zero" android:fontFamily="@font/poppins" android:textSize="@dimen/text_size_formats_desc" android:textColor="@color/onSurfaceVariant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/playerControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_small">

                        <ImageView android:id="@+id/prevButton" android:layout_width="@dimen/mini_control_button_size" android:layout_height="@dimen/mini_control_button_size" android:scaleType="fitCenter" android:src="@drawable/previous" android:padding="@dimen/spacing_small" android:background="?android:attr/selectableItemBackgroundBorderless" app:tint="@color/BLUE" android:contentDescription="@string/content_desc_previous" />
                        <FrameLayout android:layout_width="@dimen/upload_icon_container_size" android:layout_height="@dimen/upload_icon_container_size" android:layout_marginStart="@dimen/spacing_large" android:layout_marginEnd="@dimen/spacing_large">
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/record_button_bg" android:alpha="0.12" />
                            <ImageView android:id="@+id/playPauseButton" android:layout_width="@dimen/close_icon_size" android:layout_height="@dimen/close_icon_size" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/play" android:background="?android:attr/selectableItemBackgroundBorderless" app:tint="@color/BLUE" android:contentDescription="@string/content_desc_play" />
                        </FrameLayout>
                        <ImageView android:id="@+id/nextButton" android:layout_width="@dimen/mini_control_button_size" android:layout_height="@dimen/mini_control_button_size" android:scaleType="fitCenter" android:src="@drawable/next" android:padding="@dimen/spacing_small" android:background="?android:attr/selectableItemBackgroundBorderless" app:tint="@color/BLUE" android:contentDescription="@string/content_desc_next" />
                        <ImageView android:id="@+id/stopButtonMini" android:layout_width="@dimen/mini_control_button_size" android:layout_height="@dimen/mini_control_button_size" android:layout_marginStart="@dimen/spacing_normal" android:scaleType="fitCenter" android:src="@drawable/stop1" android:padding="@dimen/spacing_small" android:background="?android:attr/selectableItemBackgroundBorderless" app:tint="@color/red" android:contentDescription="@string/content_desc_stop" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_large"
                    android:paddingEnd="@dimen/spacing_large"
                    android:paddingBottom="@dimen/spacing_large"
                    android:paddingTop="@dimen/spacing_small">

                    <LinearLayout android:id="@+id/processAudioButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackgroundBorderless">
                        <FrameLayout android:layout_width="@dimen/record_center_icon_size" android:layout_height="@dimen/record_center_icon_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/record_button_bg" android:alpha="0.15" /><ImageView android:layout_width="@dimen/upload_icon_size" android:layout_height="@dimen/upload_icon_size" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/process" app:tint="@color/BLUE" /></FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium_tiny" android:text="@string/btn_process" android:fontFamily="@font/poppins_medium" android:textSize="@dimen/text_size_record_sheet_btn" android:textColor="@color/BLUE" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/newRecordingButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackgroundBorderless">
                        <FrameLayout android:layout_width="@dimen/record_center_icon_size" android:layout_height="@dimen/record_center_icon_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/record_button_bg" android:alpha="0.10" /><ImageView android:layout_width="@dimen/upload_icon_size" android:layout_height="@dimen/upload_icon_size" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/start" app:tint="@color/BLUE" /></FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium_tiny" android:text="@string/btn_new" android:fontFamily="@font/poppins_medium" android:textSize="@dimen/text_size_record_sheet_btn" android:textColor="@color/BLUE" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/deleteButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackgroundBorderless">
                        <FrameLayout android:layout_width="@dimen/record_center_icon_size" android:layout_height="@dimen/record_center_icon_size"><View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/delete_button_bg" android:alpha="0.15" /><ImageView android:layout_width="@dimen/upload_icon_size" android:layout_height="@dimen/upload_icon_size" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/delete1" app:tint="@color/red" /></FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_medium_tiny" android:text="@string/btn_delete" android:fontFamily="@font/poppins_medium" android:textSize="@dimen/text_size_record_sheet_btn" android:textColor="@color/red" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlays stay outside ScrollView -->
    <FrameLayout android:id="@+id/progressOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/modal_blur" android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="@dimen/spacing_extra_large" android:background="@drawable/dialog_background_rounded" android:minWidth="@dimen/progress_overlay_min_width">
            <ProgressBar android:layout_width="@dimen/progress_bar_size" android:layout_height="@dimen/progress_bar_size" android:indeterminateTint="@color/BLUE" />
            <TextView android:id="@+id/progressText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_normal" android:text="@string/processing_label" android:fontFamily="@font/poppins_medium" android:textSize="@dimen/text_size_instruction" android:textColor="@color/onSurfaceColor" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:id="@+id/touchBlockOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/transparent" android:visibility="gone" />

</FrameLayout>
