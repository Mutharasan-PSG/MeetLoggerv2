<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    tools:context=".ReportFragment">

    <!-- Main Topic -->
    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/proccessedDocumentsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/search_margin_horizontal"
            android:text="@string/summarized_files"
            android:textSize="@dimen/audio_topic_text_size"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/BLUE"
            android:layout_marginTop="@dimen/audio_topic_margin_top"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/audioListIcon"
            android:layout_width="@dimen/login_logo_height"
            android:layout_height="@dimen/login_logo_height"
            android:layout_marginTop="@dimen/profile_pic_margin_top"
            android:layout_marginEnd="@dimen/search_margin_horizontal"
            android:scaleType="fitXY"
            android:padding="@dimen/spacing_medium"
            android:src="@drawable/audioo"
            android:contentDescription="@string/content_desc_open_audio_list"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/placeholderImage"
            android:layout_width="@dimen/audio_options_width"
            android:layout_height="@dimen/audio_options_height"
            android:scaleType="fitXY"
            android:layout_gravity="center"
            android:src="@drawable/documents"
            android:contentDescription="@string/content_desc_no_files"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/placeholderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/onSurfaceVariant"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/deleteIcon"
            android:layout_width="@dimen/list_item_icon_size"
            android:layout_height="@dimen/list_item_icon_size"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/search_margin_horizontal"
            android:layout_marginTop="@dimen/audio_topic_margin_top"
            android:src="@drawable/delete1"
            android:contentDescription="@string/content_desc_delete"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/tickIcon"
            android:layout_width="@dimen/profile_pic_size"
            android:layout_height="@dimen/profile_pic_size"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/search_margin_horizontal"
            android:layout_marginTop="@dimen/app_logo_margin_start"
            android:src="@drawable/tick"
            android:contentDescription="@string/content_desc_tick"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:queryHint="@string/search_documents_hint"
            android:iconifiedByDefault="false"
            android:layout_marginTop="@dimen/audio_list_search_margin_top"
            android:layout_marginBottom="@dimen/search_margin_bottom"
            android:layout_marginStart="@dimen/search_margin_horizontal"
            android:layout_marginEnd="@dimen/search_margin_horizontal"
            android:visibility="gone"
            android:background="@drawable/searchview_border"/>

        <CheckBox
            android:id="@+id/selectAllCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginTop="@dimen/select_all_margin_top"
            android:layout_marginStart="45dp"
            android:fontFamily="@font/poppins"
            android:text="@string/select_all"
            android:textSize="@dimen/text_size_normal"
            android:visibility="gone" />

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/search_margin_horizontal"
            android:layout_marginEnd="@dimen/search_margin_horizontal"
            android:layout_marginTop="@dimen/audio_list_view_margin_top"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <!-- Progress Overlay -->
        <FrameLayout
            android:id="@+id/progressOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/modal_blur"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ProgressBar
                android:id="@+id/operationProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/BLUE"
                android:indeterminateTintMode="src_in" />
        </FrameLayout>
    </FrameLayout>

    <!-- No Internet Container -->
    <LinearLayout
        android:id="@+id/noInternetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/noInternetImage"
            android:layout_width="@dimen/no_internet_image_size"
            android:layout_height="@dimen/no_internet_image_size"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:src="@drawable/no_internet"
            android:contentDescription="@string/content_desc_no_internet" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/touchBlockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone" />
</FrameLayout>