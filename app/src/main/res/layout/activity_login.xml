<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    android:background="@color/backgroundColor"
    >


    <TextView
        android:id="@+id/AppContext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/login_slogan_margin_top"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/app_slogan"
        android:textColor="@color/black"
        android:textSize="@dimen/login_slogan_text_size" />

    <ImageView
        android:id="@+id/AppIcon"
        android:layout_width="@dimen/login_logo_width"
        android:layout_height="@dimen/login_logo_height"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/AppContext"
        android:layout_marginTop="@dimen/login_logo_margin_top"
        android:src="@drawable/splashlogo" />

    <RelativeLayout
        android:id="@+id/Signin"
        android:layout_below="@id/AppIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/search_margin_bottom"
        android:layout_centerHorizontal="true">

        <!-- Text for Existing Users -->
        <LinearLayout
            android:id="@+id/btn_google_sign_in"
            android:layout_width="@dimen/google_signin_width"
            android:layout_height="@dimen/google_signin_height"
            android:layout_alignParentTop="true"
            android:background="@drawable/rounded_corners"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal"
            >

            <ImageView
                android:id="@+id/google_logo"
                android:layout_width="@dimen/option_icon_size"
                android:layout_height="@dimen/option_icon_size"
                android:layout_marginStart="@dimen/google_logo_margin_start"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:scaleType="fitCenter"
                android:src="@drawable/google_logo" />

            <TextView
                android:id="@+id/google_sign_in_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_extra_large"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/sign_in_with_google"
                android:textColor="@color/fixed_white"
                android:textSize="@dimen/text_size_normal" />
        </LinearLayout>

        <TextView
            android:id="@+id/privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_google_sign_in"
            android:layout_marginTop="@dimen/profile_pic_margin_top"
            android:layout_marginStart="62dp"
            android:layout_marginEnd="@dimen/profile_pic_margin_top"
            android:layout_marginBottom="@dimen/option_item_padding"
            android:gravity="start"
            android:fontFamily="@font/poppins"
            android:text="@string/privacy_policy_agreement"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="@dimen/text_size_medium" />
    </RelativeLayout>
</RelativeLayout>