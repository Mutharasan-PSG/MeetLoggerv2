<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_background_rounded"
    android:paddingHorizontal="@dimen/dialog_padding"
    android:paddingBottom="@dimen/spacing_extra_large">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/drag_handle_width"
        android:layout_height="@dimen/drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/drag_handle_margin_top"
        android:layout_marginBottom="@dimen/drag_handle_margin_bottom"
        android:background="@color/dividerColor" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/title_terms_conditions"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_semibold" />

        <ImageView
            android:id="@+id/buttonClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/spacing_medium_tiny"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_vector"
            android:contentDescription="@string/dialog_cancel"
            app:tint="@color/Grey" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dividerColor"
        android:layout_marginBottom="@dimen/spacing_large" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/policyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/onSurfaceColor"
            android:textSize="@dimen/text_size_small"
            android:lineSpacingMultiplier="1.25"
            android:fontFamily="@font/poppins"
            android:justificationMode="inter_word"
            tools:text="Terms content goes here..." />

    </ScrollView>

</LinearLayout>
