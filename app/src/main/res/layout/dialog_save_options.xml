<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="19dp"
    android:background="@drawable/dialog_background_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <TextView
        android:id="@+id/warning_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_title_warning"
        android:textSize="18sp"
        android:textColor="@color/red"
        android:fontFamily="@font/poppins_medium"
        android:paddingBottom="8dp" />

        <ImageView
            android:id="@+id/cancel_button"
            android:layout_width="17dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"
            android:src="@drawable/dialog_close"
            android:contentDescription="@string/dialog_cancel"
            android:layout_marginStart="180dp"
            android:layout_gravity="end" />

    </LinearLayout>

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:justificationMode="inter_word"
        android:text="@string/msg_overwrite_warning"
        android:textColor="@color/onSurfaceColor"
        android:textSize="16sp"
        android:fontFamily="@font/poppins"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/overwrite_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="7dp"
            android:text="@string/dialog_overwrite"
            android:textColor="@color/red"
            android:fontFamily="@font/poppins_medium"/>

        <Button
            android:id="@+id/new_copy_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="7dp"
            android:text="@string/dialog_new_copy"
            android:textColor="@color/BLUE"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginStart="20dp"/>

    </LinearLayout>

</LinearLayout>