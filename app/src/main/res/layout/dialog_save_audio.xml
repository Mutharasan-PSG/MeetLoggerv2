<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background_rounded">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_title_save_recording"
        android:textSize="18sp"
        android:textColor="@color/BLUE"
        android:fontFamily="@font/poppins_medium"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/fileNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins"
        android:hint="@string/hint_enter_file_name"
        android:textColor="@color/onSurfaceColor"
        android:background="@drawable/searchview_border"
        android:padding="@dimen/spacing_medium"
        android:textSize="@dimen/text_size_normal" />

</LinearLayout>
