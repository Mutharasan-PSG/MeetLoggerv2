<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_small">

    <LinearLayout
        android:id="@+id/listItemLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/list_item_padding"
        android:elevation="7dp"
        android:layout_marginBottom="@dimen/mini_player_margin_bottom"
        android:background="@drawable/list_item_background"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/list_item_icon_size"
            android:layout_height="@dimen/list_item_icon_size"
            android:scaleType="fitXY"
            android:src="@drawable/audio_file"
            android:layout_marginEnd="@dimen/mini_player_margin_bottom"
            android:contentDescription="AudioFileImage"/>

        <TextView
            android:id="@+id/textViewFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/list_item_text_size"
            android:textColor="@color/onSurfaceColor"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:textSize="@dimen/list_item_text_size"
            android:layout_marginStart="@dimen/mini_player_margin_bottom"
            android:textColor="@android:color/holo_red_dark" />
    </LinearLayout>

</FrameLayout>
