<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surfaceColor">

    <!-- ============================================================ -->
    <!--  Main Content                                                 -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surfaceColor">

        <!-- ── Drag Handle ── -->
        <View
            android:layout_width="@dimen/drag_handle_width"
            android:layout_height="@dimen/drag_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/drag_handle_margin_top"
            android:layout_marginBottom="@dimen/drag_handle_margin_bottom"
            android:background="@color/dividerColor" />

        <!-- ── Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_extra_large"
            android:paddingEnd="@dimen/spacing_extra_large"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_normal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_upload_audio"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_size_large"
                android:textColor="@color/onSurfaceColor" />

            <TextView
                android:id="@+id/audioInstructionsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_upload_instruction"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/text_size_instruction"
                android:textColor="@color/onSurfaceVariant"
                android:maxLines="2" />

        </LinearLayout>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/dividerColor"
            android:layout_marginBottom="@dimen/spacing_extra_large" />

        <!-- ── Upload zone card ── -->
        <LinearLayout
            android:id="@+id/uploadAudioButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/upload_card_height"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="@dimen/spacing_extra_large"
            android:layout_marginEnd="@dimen/spacing_extra_large"
            android:layout_marginBottom="@dimen/spacing_large"
            android:background="@drawable/bottom_sheet_card_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <!-- Upload icon in indigo circle -->
            <FrameLayout
                android:layout_width="@dimen/upload_icon_container_size"
                android:layout_height="@dimen/upload_icon_container_size"
                android:layout_marginBottom="@dimen/option_item_padding">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/record_button_bg"
                    android:alpha="0.12" />

                <ImageView
                    android:layout_width="@dimen/upload_icon_size"
                    android:layout_height="@dimen/upload_icon_size"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/uploadd"
                    android:contentDescription="@string/content_desc_upload"
                    app:tint="@color/BLUE" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_upload_audio"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/BLUE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/supported_formats_desc"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/text_size_formats_desc"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginTop="@dimen/spacing_tiny" />

        </LinearLayout>

        <!-- ── Selected file chip ── -->
        <LinearLayout
            android:id="@+id/selectedFileContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_extra_large"
            android:layout_marginEnd="@dimen/spacing_extra_large"
            android:layout_marginBottom="@dimen/screen_margin_vertical"
            android:background="@drawable/bottom_sheet_card_background"
            android:padding="@dimen/spacing_normal">

            <ImageView
                android:id="@+id/selectedFileIcon"
                android:layout_width="@dimen/selected_file_icon_size"
                android:layout_height="@dimen/selected_file_icon_size"
                android:scaleType="fitCenter"
                android:src="@drawable/audioo"
                android:layout_marginEnd="@dimen/selected_file_icon_margin_end"
                android:contentDescription="@string/content_desc_audio_file"
                app:tint="@color/onSurfaceVariant" />

            <TextView
                android:id="@+id/selectedAudioTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:text="@string/msg_no_audio_selected"
                android:textSize="@dimen/text_size_instruction"
                android:textColor="@color/onSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- ── Process Audio button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/processAudioButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_button_height"
            android:layout_marginStart="@dimen/spacing_extra_large"
            android:layout_marginEnd="@dimen/spacing_extra_large"
            android:layout_marginBottom="@dimen/action_button_margin_bottom"
            android:text="@string/btn_process_audio"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/fixed_white"
            android:textSize="@dimen/list_item_text_size"
            app:backgroundTint="@color/BLUE"
            app:cornerRadius="@dimen/action_button_corner_radius"
            app:icon="@drawable/process"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_medium"
            app:iconSize="@dimen/selected_file_icon_size"
            app:iconTint="@color/fixed_white" />

        <!-- hidden text target for observer compat -->
        <TextView
            android:id="@+id/processAudioText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/btn_process_audio" />

    </LinearLayout>

    <!-- ============================================================ -->
    <!--  Progress Overlay — same card style as RecordAudio sheet     -->
    <!-- ============================================================ -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modal_blur"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_extra_large"
            android:background="@drawable/dialog_background_rounded"
            android:minWidth="@dimen/progress_overlay_min_width">

            <ProgressBar
                android:layout_width="@dimen/progress_bar_size"
                android:layout_height="@dimen/progress_bar_size"
                android:indeterminateTint="@color/BLUE"
                android:indeterminateTintMode="src_in" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:text="@string/processing_label"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_size_instruction"
                android:textColor="@color/onSurfaceColor" />

        </LinearLayout>

    </FrameLayout>

    <!-- Touch-block overlay -->
    <FrameLayout
        android:id="@+id/touchBlockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:visibility="gone" />

</FrameLayout>