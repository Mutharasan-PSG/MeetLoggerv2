<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundColor"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding"
        android:background="@color/backgroundColor">

        <TextView
            android:id="@+id/audioInstructionsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:layout_margin="@dimen/list_item_margin_bottom"
            android:textColor="@color/Grey"
            android:text="@string/msg_upload_instruction"
            android:textSize="@dimen/instruction_text_size"
             />

        <LinearLayout
            android:id="@+id/uploadAudioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="@dimen/dialog_item_margin"
            android:gravity="center"
            android:background="@drawable/rounded_image"
            android:layout_gravity="center"
            android:padding="@dimen/profile_title_margin_top">

            <ImageView
                android:layout_width="@dimen/details_action_icon_size"
                android:layout_height="@dimen/close_icon_size"
                android:scaleType="fitXY"
                android:src="@drawable/uploadd" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_upload_audio"
                android:fontFamily="@font/poppins"
                android:textSize="@dimen/list_item_text_size"
                android:textColor="@color/onSurfaceColor"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_tiny" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectedAudioTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:layout_margin="@dimen/spacing_small"
            android:text="@string/msg_no_audio_selected"
            android:textSize="@dimen/list_item_text_size"
            android:textColor="@color/red"
            android:gravity="center"
            android:padding="@dimen/spacing_medium" />

        <LinearLayout
            android:id="@+id/processAudioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="@dimen/spacing_small"
            android:layout_gravity="center"
            android:elevation="@dimen/process_button_elevation"
            android:padding="@dimen/profile_title_margin_top"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/button_bg_export">

            <ImageView
                android:id="@+id/processAudioIcon"
                android:layout_width="@dimen/audio_icon_size"
                android:layout_height="@dimen/audio_icon_size"
                android:src="@drawable/process"
                android:layout_marginEnd="@dimen/spacing_medium" />

            <TextView
                android:id="@+id/processAudioText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_process_audio"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_normal"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modal_blur"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/BLUE"
            android:indeterminateTintMode="src_in"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/touchBlockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</FrameLayout>