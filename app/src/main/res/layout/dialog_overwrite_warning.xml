<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding"
    android:background="@drawable/dialog_background_rounded">

    <!-- Responsive Title Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_normal">

        <TextView
            android:id="@+id/warning_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/dialog_title_warning"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/red"
            android:fontFamily="@font/poppins_semibold" />

        <ImageView
            android:id="@+id/cancel_button"
            android:layout_width="@dimen/close_icon_size"
            android:layout_height="@dimen/close_icon_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/spacing_medium_tiny"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_vector"
            android:contentDescription="@string/dialog_cancel"
            app:tint="@color/Grey" />

    </RelativeLayout>

    <!-- Warning Message -->
    <TextView
        android:id="@+id/warning_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:justificationMode="inter_word"
        android:text="@string/dialog_overwrite_warning_msg"
        android:textColor="@color/onSurfaceVariant"
        android:textSize="@dimen/text_size_small"
        android:lineSpacingMultiplier="1.25"
        android:fontFamily="@font/poppins"
        android:layout_marginBottom="@dimen/spacing_extra_large"/>

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Negative action: "No" styled as TextButton -->
        <Button
            android:id="@+id/no_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_no"
            android:textColor="@color/red"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/text_size_small"
            android:layout_marginEnd="@dimen/spacing_medium" />

        <!-- Confirm action: "Yes" styled with soft red background -->
        <Button
            android:id="@+id/yes_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/popup_item_min_height"
            android:background="@drawable/button_bg_soft_red"
            app:backgroundTint="@null"
            android:text="@string/dialog_yes"
            android:textColor="@color/red"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="@dimen/text_size_small"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="@dimen/profile_sign_out_btn_padding_horizontal"
            android:paddingEnd="@dimen/profile_sign_out_btn_padding_horizontal" />

    </LinearLayout>

</LinearLayout>