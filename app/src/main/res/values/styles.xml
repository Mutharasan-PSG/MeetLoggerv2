<resources>
    <!-- Base Application Theme -->
    <style name="Theme.MeetLoggerv2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/BLUE</item>
        <item name="colorPrimaryVariant">@color/BLUE</item>
        <item name="colorOnPrimary">@color/fixed_white</item>

        <item name="colorSecondary">@color/BLUE</item>
        <item name="colorSecondaryVariant">@color/BLUE</item>
        <item name="colorOnSecondary">@color/fixed_white</item>

        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/onSurfaceColor</item>
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="colorOnBackground">@color/onBackgroundColor</item>
        <item name="android:textColorHint">@color/onSurfaceVariant</item>

        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/backgroundColor</item>

        <item name="android:alertDialogTheme">@style/CustomAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialog</item>
        <item name="materialButtonStyle">@style/ModernMaterialButton</item>
    </style>

    <!-- Modern Button Style -->
    <style name="ModernMaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Custom Text Input Layout Style to guarantee visibility in Dark Mode -->
    <style name="AuthTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_box_stroke_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/BLUE</item>
        <item name="android:textColorHint">@color/onSurfaceVariant</item>
        <item name="boxBackgroundColor">@color/surfaceColor</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="passwordToggleDrawable">@drawable/password_toggle_selector</item>
        <item name="passwordToggleTint">@color/onSurfaceVariant</item>
    </style>

    <!-- Alert Dialog Theme (used explicitly where needed, NOT set globally) -->
    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearance">@style/DialogCorners</item>
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyText</item>
    </style>

    <!-- Must use the Material dialog VIEW styles as parent (not TextAppearance styles)
         because mtrl_alert_dialog_title.xml uses these as view styles, which need
         android:layout_width and android:layout_height to be provided.
         We also specify width/height directly to guarantee compliance across all API levels. -->
    <style name="DialogTitleText" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="DialogBodyText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="DialogButtonTextAppearance" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerSize">@dimen/dialog_corner_radius</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="BottomSheetCorners">
        <item name="cornerSizeTopLeft">@dimen/dialog_corner_radius</item>
        <item name="cornerSizeTopRight">@dimen/dialog_corner_radius</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="CustomBottomSheetDialog" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="backgroundTint">@color/backgroundColor</item>
        <item name="shapeAppearanceOverlay">@style/BottomSheetCorners</item>
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- Animations & Others -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/card_slide_in</item>
        <item name="android:windowExitAnimation">@anim/card_slide_out</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>

    <!-- Bottom Nav label text appearances -->
    <style name="NavTextActive">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">@dimen/text_size_tiny</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NavTextInactive">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">@dimen/text_size_tiny</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>

